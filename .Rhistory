arrange(barcode, chain) %>%
group_by(barcode) %>%
summarize(clone_id = paste(cdr3, collapse = ":")) %>%
ungroup()
# Ensure standard Seurat prefix format (e.g., Exp01_Barcode)
tcr_meta$barcode <- paste0(prefix, "_", gsub(paste0(prefix, "_geno|_"), "", tcr_meta$barcode))
return(tcr_meta)
}
# Combine all VDJ data
vdj_all <- bind_rows(lapply(prefixes, process_vdj))
# ---------------------------------------------------------
# 3. PULL UMIs FROM ANTIGEN CSVs & BUILD MATRIX
# ---------------------------------------------------------
process_antigens <- function(prefix) {
ag_df <- read_csv(paste0("GSE275633_", prefix, "_antigen_specificity_scores.csv.gz"), show_col_types = FALSE)
# ⚠️ IMPORTANT: Change 'virus_name' and 'umi_count' to exactly match
# the column names in your antigen_specificity_scores.csv
ag_df <- ag_df %>% select(barcode, antigen, antigen_umi)
ag_df$barcode <- paste0(prefix, "_", gsub(paste0(prefix, "_geno|_"), "", ag_df$barcode))
return(ag_df)
}
# Combine all antigen CSVs
ag_all <- bind_rows(lapply(prefixes, process_antigens))
# Reshape from a long list into a wide Matrix (Rows = Viruses, Columns = Barcodes)
# Any missing values are safely filled with 0
pMHC_matrix <- ag_all %>%
pivot_wider(names_from = barcode, values_from = antigen_umi, values_fill = 0) %>%
column_to_rownames("antigen") %>%
as.matrix()
# ---------------------------------------------------------
# 4. BUILD SEURAT OBJECT & INJECT METADATA
# ---------------------------------------------------------
# Build directly from our exact matrix (ignores all other UMIs automatically)
seurat_merged <- CreateSeuratObject(counts = pMHC_matrix, assay = "pMHC")
# Keep only cells that have both antigen data AND a perfectly paired clone_id
valid_barcodes <- intersect(Cells(seurat_merged), vdj_all$barcode)
seurat_merged <- subset(seurat_merged, cells = valid_barcodes)
# Inject the clone_ids
clone_vector <- vdj_all$clone_id[match(Cells(seurat_merged), vdj_all$barcode)]
seurat_merged$clone_id <- clone_vector
# Cleanup memory
rm(pMHC_matrix, ag_all, vdj_all)
gc()
# ---------------------------------------------------------
# 5. ITRAP2 PREPARATION & EXECUTION
# ---------------------------------------------------------
# Create the required pMHC reference table based on the new exact matrix rows
pmhc_ref <- data.frame(
Barcode = rownames(seurat_merged),
pmhc    = rownames(seurat_merged) # Uses your exact virus names
)
seurat_merged@misc$pmhc <- pmhc_ref
