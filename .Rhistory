# 1. Load Required Libraries
library(Seurat)
library(dplyr)
library(readr)
library(tidyr)   # Needed to reshape your CSV into a matrix
library(tibble)  # Needed for column_to_rownames
# library(ITRAP2)
prefixes <- c("Exp01", "Exp02", "Exp03")
# ---------------------------------------------------------
# 2. EXTRACT & FIX PERFECTLY PAIRED CLONE IDs
# ---------------------------------------------------------
process_vdj <- function(prefix) {
vdj <- read_csv(paste0("GSE275633_", prefix, "_filtered_contig_annotations.csv.gz"), show_col_types = FALSE)
colnames(vdj)[1] <- "barcode"
# Find perfectly paired cells
valid_cells <- vdj %>%
filter(chain %in% c("TRA", "TRB")) %>%
group_by(barcode) %>%
summarize(n_TRA = sum(chain == "TRA"), n_TRB = sum(chain == "TRB")) %>%
filter(n_TRA == 1 & n_TRB == 1) %>%
pull(barcode)
# Paste TRA and TRB together to form accurate clone_id
tcr_meta <- vdj %>%
filter(barcode %in% valid_cells) %>%
select(barcode, chain, cdr3) %>%
arrange(barcode, chain) %>%
group_by(barcode) %>%
summarize(clone_id = paste(cdr3, collapse = ":")) %>%
ungroup()
# Ensure standard Seurat prefix format (e.g., Exp01_Barcode)
tcr_meta$barcode <- paste0(prefix, "_", gsub(paste0(prefix, "_geno|_"), "", tcr_meta$barcode))
return(tcr_meta)
}
# Combine all VDJ data
vdj_all <- bind_rows(lapply(prefixes, process_vdj))
