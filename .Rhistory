seurat_merged@misc$pmhc %>% head()
seurat_merged@meta.data$clone_id %>% head(10)
seurat_merged@misc$pmhc$Sequence <- seurat_merged$clone_id[match(seurat_merged@misc$pmhc$Barcode, colnames(seurat_merged))]
head(seurat_merged@misc$pmhc)
clones <- seurat_merged$clone_id %>% table() %>% sort(decreasing = T) %>% names()
